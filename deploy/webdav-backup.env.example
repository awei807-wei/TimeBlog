# Install as /etc/timeblog/webdav-backup.env with root:root ownership and mode 0600.
# This file contains paths and policy only. Keep rclone credentials in the
# separate root-owned RCLONE_CONFIG file and never copy deploy/.env to WebDAV.
TIMEBLOG_PROJECT_DIR=/opt/timeblog
COMPOSE_FILE=/opt/timeblog/deploy/compose.yaml
COMPOSE_ENV_FILE=/opt/timeblog/deploy/.env
BACKUP_DIR=/srv/timeblog/backup-staging
WEBDAV_REMOTE=webdav:Google1/TimeBlog/backups
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
WEBDAV_BACKUP_LOCK=/run/lock/timeblog-webdav-backup.lock
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=2
LOCAL_RETENTION_COUNT=7
REMOTE_RETENTION_COUNT=90
BACKUP_RETENTION_DRY_RUN=0
