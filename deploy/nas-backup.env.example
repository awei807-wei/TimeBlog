# Copy to /etc/timeblog/nas-backup.env on the NAS and restrict it to 0600.
# The source SSH account must be read-only and its host key must be manually
# verified in the timeblog-backup user's ~/.ssh/known_hosts.
SOURCE_HOST=backup-source
SOURCE_PATH=/srv/timeblog/backup-staging
DEST_PATH=/srv/timeblog/nas-snapshots
RETENTION_DAYS=90
# Optional; empty means select the newest SHA256SUMS-<stamp> on the source.
STAMP=
