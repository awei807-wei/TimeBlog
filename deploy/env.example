# Use URL-safe characters only (A-Z a-z 0-9 _ -) because this value is
# interpolated into DATABASE_URL by compose.
POSTGRES_PASSWORD=replace-with-high-entropy-url-safe-secret
ADMIN_PASSWORD=replace-before-start
ADMIN_TOTP_SECRET=BASE32_SECRET_FROM_ADMINCTL
TOTP_ENCRYPTION_KEY=BASE64URL_32_BYTE_KEY
# 独立于 TOTP 密钥，用于加密写入数据库的第三方集成 Token。
CONFIG_ENCRYPTION_KEY=BASE64URL_32_BYTE_KEY
# 首次启动且数据库没有有效恢复码时设置；恢复码写入数据库哈希后立即删除该变量。
ACCOUNT_RECOVERY_KEY_BOOTSTRAP=
# 仅填写受信反向代理网段（逗号分隔）；未命中的 RemoteAddr 不采信 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
SITE_URL=http://localhost:3000
SITE_HOST=localhost
TIMEZONE=Asia/Shanghai
MEDIA_ROOT=/srv/timeline/media
EXPORT_ROOT=/srv/timeline/exports
# 单个媒体文件和 ZIP 内媒体文件上限（字节，默认 209715200；范围 1MiB–2GiB）。
MAX_UPLOAD_BYTES=209715200
