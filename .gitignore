backups/
*.dump
*.tar
*.tar.gz
*.zip
*.tgz

# OS/editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Go build/test artifacts
bin/
*.test

# Generated reports and local test fixtures
playwright-report/
test-results/

